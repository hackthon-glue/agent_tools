# AWS Configuration
# Required for AgentCore Browser functionality
AWS_PROFILE=ai-hackathon
AWS_REGION=us-west-2

# DynamoDB Tables
DYNAMODB_USERS_TABLE=recruitment_users
DYNAMODB_JOBS_TABLE=recruitment_jobs
DYNAMODB_GITHUB_TABLE=recruitment_github_profiles

# Knowledge Base
KNOWLEDGE_BASE_ID=your_bedrock_knowledge_bases_id
KB_USE_RERANK=true
KB_SEARCH_TYPE=HYBRID
KB_MAX_RESULTS=5
KB_TEMPERATURE=0
KB_MAX_TOKENS=1024

# Memory
MEMORY_ID=your_agentcore_memory_id
CONCIERGE_SESSION_TTL=3600
INTERVIEWER_SESSION_TTL=1800

# Model
CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# GitHub API (Optional - for enhanced data collection)
# Without token: 60 requests/hour, basic validation only
# With token: 5,000 requests/hour, full profile data
GITHUB_TOKEN=your_github_personal_access_token

# LinkedIn API (Optional - currently not available for free)
# System works without this using URL validation
LINKEDIN_API_KEY=your_linkedin_api_key

