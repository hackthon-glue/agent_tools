# AWS Configuration
# Required for AgentCore Browser functionality
AWS_PROFILE=ai-hackathon
AWS_REGION=us-west-2

# IMPORTANT: AgentCore Browser requires:
# 1. AWS credentials configured (aws configure)
# 2. IAM permissions: bedrock-agentcore:* and bedrock:InvokeModel
# 3. Bedrock model access: Enable "Anthropic Claude Sonnet 4.0" in AWS Console
#    https://console.aws.amazon.com/bedrock/home?region=us-west-2#/modelaccess

# GitHub API (Optional - for enhanced data collection)
# Without token: 60 requests/hour, basic validation only
# With token: 5,000 requests/hour, full profile data
GITHUB_TOKEN=your_github_personal_access_token

# LinkedIn API (Optional - currently not available for free)
# System works without this using URL validation
LINKEDIN_API_KEY=your_linkedin_api_key

# AgentCore Memory (Optional)
AGENTCORE_MEMORY_ID=optional-memory-id

# Browser Settings
BROWSER_HEADLESS=true
