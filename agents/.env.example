# AWS Configuration
AWS_PROFILE=ai-hackathon
AWS_REGION=us-west-2

# RDS Database
DB_HOST=your-rds-host.rds.amazonaws.com
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=glue
DB_PORT=5432

# Knowledge Base
KNOWLEDGE_BASE_ID=XXXXXXXXXX
KB_DATA_SOURCE_ID=YYYYYYYYYY
KB_S3_BUCKET=your-knowledge-bucket

# SageMaker Fake News Detection
SAGEMAKER_ENDPOINT_NAME=fake-news-detection-endpoint
FAKE_NEWS_THRESHOLD=0.7

# AgentCore Memory
AGENTCORE_MEMORY_ID=optional-memory-id

# Browser Settings
BROWSER_HEADLESS=true

# Flight API
AMADEUS_API_KEY = your_amadeus_api_key
AMADEUS_API_SECRET = your_amadeus_secret_key
